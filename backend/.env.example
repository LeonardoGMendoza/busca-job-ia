# Copie para .env. NUNCA suba o .env para o GitHub.
# IA da Oracle (os MESMOS valores do VinaCare/StudentMedical). Sem eles, a atendente entende por regra.
OCI_USER=
OCI_FINGERPRINT=
OCI_TENANCY=
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=
OCI_KEY_B64=
# Senha para publicar/remover vagas de parceiros e ver os cliques
BJ_TOKEN=
BJ_DATA_DIR=./data
BJ_ORIGENS=http://localhost:5500,https://leonardogmendoza.github.io
# Vagas reais dentro do app (opcional, mas é o que mostra as vagas de verdade)
# JSearch = Google Vagas. Chave grátis (200 buscas/mês) em https://www.openwebninja.com (ou RapidAPI: JSEARCH_PROVEDOR=rapidapi)
JSEARCH_KEY=
JSEARCH_PROVEDOR=openwebninja
# Jooble: uma chave por país, pedida em https://br.jooble.org/api/about (troque br por ar, pe, py)
JOOBLE_KEY_BR=
JOOBLE_KEY_AR=
JOOBLE_KEY_PE=
JOOBLE_KEY_PY=
